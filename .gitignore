# ==============================================================================
# File: .//Description-of-file/gitignore.md
# Overview: Specifies intentionally untracked files, builds, local databases, and secrets to ignore in Git.
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build outputs
/.next/
/out/

# Production builds
/build

# Local SQLite databases and storage
kratuu.db
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Markdown and documentation files
*.md
Description-of-file/
!README.md

# System and OS files
.DS_Store
Thumbs.db
*.pem

# Debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables and secrets
.env*
!.env.example

# Deployment platforms
.vercel

# TypeScript build metadata
*.tsbuildinfo
next-env.d.ts
