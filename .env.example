# MongoDB Connection
# Replace with your MongoDB Atlas connection string (or local MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kratuu

# SMTP Email Configuration (Optional - for sending live 6-digit email OTPs)
# If omitted, OTPs will be displayed in the server terminal console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
