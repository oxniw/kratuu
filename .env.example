# MongoDB Connection
# Replace with your MongoDB Atlas connection string (or local MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kratuu

# Google OAuth 2.0 Credentials (Optional)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP Email Configuration (Optional - for sending live 6-digit email OTPs)
# If omitted, OTPs will be displayed in the server terminal console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
